# Text uses LF on every platform; Windows command scripts require CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Spec fixtures are matched by character offset, so their line endings are part
# of the expected values. Checked out with CRLF on Windows, every offset past
# the first line drifts by one per line and the scanner specs fail on numbers
# that are correct for the content but wrong for the file on disk.
spec/fixtures/** text eol=lf

# Except this one, whose whole point is to be scanned with CRLF endings.
spec/fixtures/crlf.styl -text

/docs export-ignore
/spec export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
